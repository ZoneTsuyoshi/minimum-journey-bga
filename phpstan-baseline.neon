# Studio の雛形（Game.php・NextPlayer.php のサンプルコード）に対する既知の指摘。
# 雛形の置き換え（実装タスク）でこのファイルごと外す。新規コードの指摘をここに足さない（仕様書 004 第 2.4 節）。
parameters:
	ignoreErrors:
		-
			message: '#^Variable \$query_values might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: src/modules/php/Game.php

		-
			message: '#^If condition is always false\.$#'
			identifier: if.alwaysFalse
			count: 1
			path: src/modules/php/States/NextPlayer.php
