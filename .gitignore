# 作業用ワークツリー（タスクごとに .worktrees/<ブランチ名> を作成する）
.worktrees/

# OS / エディタ
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# 依存パッケージ・ビルド生成物
node_modules/
vendor/
dist/
*.log

# 認証情報（BGA Studio の SFTP 情報などは絶対にコミットしない）
.env
.env.*
!.env.example
sftp.json
.vscode/sftp.json
*.pem
id_rsa*
id_ed25519*

# Claude Code のローカル設定
.claude/settings.local.json

# BGA 配布物の開発用スタブ（ライセンスが不明なためコミットしない。ローカルに置く場合のみ）
/tools/bga/_ide_helper.php
/tools/bga/bga-framework.d.ts

# スプライト生成物（CI とローカルで scripts/build-sprites.mjs が生成する。仕様書 009 §5.5）
/src/img/cards_*.webp
/src/img/icons.webp
/build/

# PHPUnit のキャッシュ
.phpunit.result.cache
