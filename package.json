{
  "name": "minimum-journey-bga",
  "private": true,
  "description": "MINIMUM JOURNEY の Board Game Arena 実装（開発用ツール。src/ には含めない）",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "npm run lint:md && npm run lint:repo && npm run lint:js && npm run lint:strict && npm run lint:types && npm run lint:css",
    "lint:md": "markdownlint-cli2",
    "lint:repo": "node scripts/lint/check-repo.mjs",
    "lint:js": "eslint .",
    "lint:strict": "node scripts/lint/check-strict-types.mjs",
    "lint:types": "node scripts/lint/check-types.mjs",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:links": "lychee --config lychee.toml \"./**/*.md\"",
    "build:sprites": "node scripts/build-sprites.mjs",
    "check:sprites": "node scripts/check-sprites.mjs",
    "check:cards": "node scripts/check-card-definitions.mjs",
    "test:integration": "sh tests/run-integration.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "sharp": "0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
