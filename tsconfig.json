// J2: JavaScript の型チェック（仕様書 004 第 2.6 節）。実行: npm run lint:types
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/modules/js/**/*.js", "tools/bga/bga-framework.d.ts"]
}
